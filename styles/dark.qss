/* VS Code Dark inspired application theme */

QWidget {
    background-color: #1e1e1e;
    color: #dcdfe4;
    font-family: 'Segoe UI', 'Vazirmatn', sans-serif;
    font-size: 14px;
}

QDialog, QFrame[frameShape="4"] {
    background-color: #202226;
    border: 1px solid #313335;
    border-radius: 10px;
}

QLabel {
    color: #dcdfe4;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QComboBox {
    background-color: #252526;
    color: #f3f3f3;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 6px 8px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #569cd6;
    box-shadow: 0px 0px 6px rgba(86, 156, 214, 0.45);
}

QComboBox QAbstractItemView {
    background-color: #252526;
    selection-background-color: #094771;
    selection-color: #ffffff;
    border: 1px solid #3c3c3c;
}

QPushButton {
    background-color: #2d2d2d;
    color: #f3f3f3;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #37373d;
    border-color: #569cd6;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0e639c;
    border-color: #0e639c;
}

QToolButton {
    background-color: transparent;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: transparent;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #42464d;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:hover {
    background-color: #4f5663;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QListWidget,
QTreeWidget,
QTableWidget,
QTableView {
    background-color: #1f2430;
    border: 1px solid #2f333d;
    border-radius: 10px;
    padding: 8px;
    color: #dcdfe4;
    gridline-color: #2f333d;
}

QListWidget::item,
QTreeWidget::item {
    padding: 8px;
    border-radius: 6px;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTabWidget::pane {
    border: 1px solid #30363f;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #252526;
    color: #dcdfe4;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-bottom: 2px solid #569cd6;
}

QMenu {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    color: #f3f3f3;
}

QMenu::item {
    padding: 6px 16px;
}

QMenu::item:selected {
    background-color: #094771;
}

QToolTip {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #569cd6;
    padding: 6px;
    border-radius: 6px;
}

QProgressBar {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
}

QProgressBar::chunk {
    background-color: #0e639c;
    border-radius: 8px;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background-color: #252526;
}

QCheckBox::indicator:checked {
    background-color: #0e639c;
    border-color: #0e639c;
}

QGroupBox {
    border: 1px solid #30363f;
    border-radius: 8px;
    margin-top: 24px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9cdcfe;
}

QStatusBar {
    background-color: #252526;
    color: #c8ccd4;
    border-top: 1px solid #2f333d;
}
